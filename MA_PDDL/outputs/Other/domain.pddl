(define (domain push-box)
(:requirements :typing :fluents :continuous-effects :time :negative-preconditions )
(:types agent box )
(:predicates (pushing ?a - agent ?b - box )(dif_agent ?ob1 - agent ?ob2 - agent )(dif_box ?ob1 - box ?ob2 - box ))
(:functions (box-pos ?b - box )(push-power ?a - agent ))
(:process move-box :parameters (?a - agent ?b - box ):precondition (pushing ?a ?b ):effect (increase (box-pos ?b )(* #t (push-power ?a ))))
)
